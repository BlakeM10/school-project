<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CourtVision" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cv_primary</item>
        <item name="colorOnPrimary">@color/cv_on_primary</item>
        <item name="colorPrimaryContainer">@color/cv_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/cv_on_primary_container</item>
        <item name="colorSecondary">@color/cv_secondary</item>
        <item name="colorOnSecondary">@color/cv_on_secondary</item>
        <item name="colorSecondaryContainer">@color/cv_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/cv_on_secondary_container</item>
        <item name="android:colorBackground">@color/cv_background</item>
        <item name="colorOnBackground">@color/cv_on_background</item>
        <item name="colorSurface">@color/cv_surface</item>
        <item name="colorOnSurface">@color/cv_on_surface</item>
        <item name="colorSurfaceVariant">@color/cv_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/cv_on_surface_variant</item>
        <item name="colorOutline">@color/cv_outline</item>
        <item name="colorError">@color/cv_error</item>
        <item name="colorOnError">@color/cv_on_error</item>

        <!-- Softer, more modern corner language app-wide -->
        <item name="shapeAppearanceSmallComponent">@style/Shape.CourtVision.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.CourtVision.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.CourtVision.Large</item>
    </style>

    <style name="Shape.CourtVision.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Shape.CourtVision.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Shape.CourtVision.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Reusable widget styles -->
    <style name="Widget.CourtVision.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.CourtVision.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.CourtVision.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.CourtVision.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CourtVision.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
